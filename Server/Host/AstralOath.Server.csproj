<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="[2.6.2]" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="[10.0.9]" />
    <ProjectReference Include="../../Shared/com.astraloath.shared/AstralOath.Shared.csproj" />
    <ProjectReference Include="../../Shared/com.astraloath.shared/Runtime/Battle/AstralOath.Battle.csproj" />
    <EmbeddedResource Include="Foundation/Migrations/*.sql" />
    <EmbeddedResource Include="Inventory/training-equipment.json" LogicalName="AstralOath.TrainingEquipment" />
    <EmbeddedResource Include="Arena/arena-chat-stickers.txt" LogicalName="AstralOath.ArenaChatStickers" />
    <EmbeddedResource Include="Summon/summon-banners.json" LogicalName="AstralOath.SummonBanners" Condition="Exists('Summon/summon-banners.json')" />
    <EmbeddedResource Include="../../Assets/Game/Modules/Home/Configs/artifact-catalog.json"
                      LogicalName="AstralOath.ArtifactCatalog" Condition="Exists('../../Assets/Game/Modules/Home/Configs/artifact-catalog.json')" />
    <EmbeddedResource Include="../../Assets/Game/Modules/BattleScene/Configs/battle-catalog.json"
                      LogicalName="AstralOath.BattleCatalog" />
  </ItemGroup>
</Project>
