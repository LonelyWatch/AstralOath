<module name="battle">
  <bean name="HeroRow">
    <var name="id" type="string"/>
    <var name="nameKey" type="string#ref=characterlab.Messages"/>
    <var name="element" type="string"/>
    <var name="heroClass" type="string"/>
    <var name="zodiac" type="string"/>
    <var name="growthPresetId" type="string#ref=battle.BattleGrowthPresets"/>
    <var name="baseStars" type="int#range=[1,6]"/>
    <var name="level" type="int#range=[1,60]"/>
    <var name="stars" type="int#range=[1,6]"/>
    <var name="awakenings" type="int#range=[0,6]"/>
    <var name="variant" type="string"/>
    <var name="attack" type="int#range=[1,100000]"/>
    <var name="health" type="int#range=[1,1000000]"/>
    <var name="defense" type="int#range=[1,100000]"/>
    <var name="speed" type="int#range=[1,1000]"/>
    <var name="critChanceBp" type="int#range=[0,10000]"/>
    <var name="critDamageBp" type="int#range=[10000,35000]"/>
    <var name="effectivenessBp" type="int#range=[0,100000]"/>
    <var name="effectResistanceBp" type="int#range=[0,100000]"/>
    <var name="resourceKind" type="string"/>
    <var name="resourceMaximum" type="int#range=[0,100000]"/>
    <var name="resourceTurnGain" type="int#range=[0,100000]"/>
    <var name="resourceAttackedSpend" type="int#range=[0,100000]"/>
    <var name="resourceOpeningGain" type="int#range=[0,100000]"/>
    <var name="resourceAttackedGain" type="int#range=[0,100000]"/>
  </bean>

  <bean name="GrowthPresetRow">
    <var name="id" type="string"/>
    <var name="nativeStars" type="int#range=[1,6]"/>
    <var name="heroClass" type="string"/>
    <var name="zodiac" type="string"/>
    <var name="attackCoefficientMilli" type="int#range=[1,10000000]"/>
    <var name="healthCoefficientMilli" type="int#range=[1,10000000]"/>
    <var name="defenseCoefficientMilli" type="int#range=[1,10000000]"/>
    <var name="speedMilli" type="int#range=[1,1000000]"/>
  </bean>

  <bean name="AwakeningStepRow">
    <var name="id" type="string"/>
    <var name="heroId" type="string#ref=battle.BattleHeroes"/>
    <var name="rank" type="int#range=[1,6]"/>
    <var name="attackFlat" type="int#range=[0,100000]"/>
    <var name="healthFlat" type="int#range=[0,1000000]"/>
    <var name="attackPercentBp" type="int#range=[0,100000]"/>
    <var name="healthPercentBp" type="int#range=[0,100000]"/>
    <var name="defensePercentBp" type="int#range=[0,100000]"/>
    <var name="speedFlat" type="int#range=[0,1000]"/>
    <var name="critChanceBp" type="int#range=[0,10000]"/>
    <var name="critDamageBp" type="int#range=[0,35000]"/>
    <var name="effectivenessBp" type="int#range=[0,100000]"/>
    <var name="effectResistanceBp" type="int#range=[0,100000]"/>
  </bean>

  <bean name="SkillRow">
    <var name="id" type="string"/>
    <var name="heroId" type="string#ref=battle.BattleHeroes"/>
    <var name="slot" type="int#range=[1,3]"/>
    <var name="nameKey" type="string#ref=battle.BattleMessages"/>
    <var name="descriptionKey" type="string#ref=battle.BattleMessages"/>
    <var name="presentationId" type="string"/>
    <var name="iconAsset" type="string"/>
    <var name="target" type="string"/>
    <var name="cooldownTurns" type="int#range=[0,30]"/>
    <var name="soulGain" type="int#range=[0,30]"/>
    <var name="soulBurnCost" type="int#range=[0,30]"/>
    <var name="soulBurnKind" type="string"/>
    <var name="soulBurnTurns" type="int#range=[0,30]"/>
    <var name="attackRateBp" type="int?"/>
    <var name="powerBp" type="int?"/>
    <var name="casterHealthDamageBp" type="int?"/>
    <var name="casterHealthHealBp" type="int?"/>
    <var name="casterHealthBarrierBp" type="int?"/>
    <var name="burnAttackRateBp" type="int?"/>
    <var name="casterDefenseBarrierBp" type="int?"/>
    <var name="casterDefenseDamageBp" type="int?"/>
    <var name="casterSpeedDamagePpm" type="int?"/>
    <var name="burnSpeedDamagePpm" type="int?"/>
    <var name="casterHealthRatioDamageBp" type="int?"/>
    <var name="damageAgainstBuffBp" type="int?"/>
    <var name="defensePenetrationBp" type="int?"/>
    <var name="stealthPenetrationBp" type="int?"/>
    <var name="highestDefensePenetrationBp" type="int?"/>
    <var name="alwaysCritical" type="bool"/>
    <var name="aoeWhenBuffed" type="bool"/>
    <var name="aoeOutsideTurn" type="bool"/>
    <var name="casterAttackBarrierBp" type="int?"/>
    <var name="resourceCost" type="int#range=[0,100000]"/>
    <var name="resourceGain" type="int#range=[0,100000]"/>
    <var name="resourceGainWhenBuffed" type="int#range=[0,100000]"/>
  </bean>

  <bean name="SkillEffectRow">
    <var name="id" type="string"/>
    <var name="skillId" type="string#ref=battle.BattleSkills"/>
    <var name="order" type="int#range=[1,64]"/>
    <var name="phase" type="string"/>
    <var name="operation" type="string"/>
    <var name="recipient" type="string"/>
    <var name="status" type="string"/>
    <var name="chanceBp" type="int#range=[1,10000]"/>
    <var name="turns" type="int#range=[0,30]"/>
    <var name="value" type="int#range=[0,100000]"/>
    <var name="condition" type="string"/>
    <var name="chanceBonusStatus" type="string"/>
    <var name="chanceBonusBp" type="int#range=[0,10000]"/>
  </bean>

  <bean name="EnhancementRow">
    <var name="id" type="string"/>
    <var name="skillId" type="string#ref=battle.BattleSkills"/>
    <var name="step" type="int#range=[1,15]"/>
    <var name="kind" type="string"/>
    <var name="value" type="int#range=[1,10000]"/>
  </bean>

  <bean name="MessageRow">
    <var name="key" type="string"/>
    <var name="zhCn" type="string"/>
  </bean>

  <table name="BattleHeroes" value="HeroRow" input="battle_heroes.csv"/>
  <table name="BattleGrowthPresets" value="GrowthPresetRow" input="battle_growth_presets.csv"/>
  <table name="BattleAwakeningSteps" value="AwakeningStepRow" input="battle_awakening_steps.csv"/>
  <table name="BattleSkills" value="SkillRow" input="battle_skills.csv"/>
  <table name="BattleSkillEffects" value="SkillEffectRow" input="battle_skill_effects.csv"/>
  <table name="BattleSkillEnhancements" value="EnhancementRow" input="battle_skill_enhancements.csv"/>
  <table name="BattleMessages" value="MessageRow" input="battle_messages.csv"/>
</module>