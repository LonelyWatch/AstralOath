  "messages": [
    {
      "key": "battle.skill.c1001.s1.name",
      "zhCn": "十字斩"
    },
    {
      "key": "battle.skill.c1001.s1.description",
      "zhCn": "攻击一名敌人，有75%概率解除其一个增益。伤害随施术者最大生命提高。"
    },
    {
      "key": "battle.skill.c1001.s2.name",
      "zhCn": "指挥一击"
    },
    {
      "key": "battle.skill.c1001.s2.description",
      "zhCn": "攻击一名敌人，随后由攻击最高的可用友军发动夹攻。魂燃消耗10魂，使本技能冷却减少2回合。"
    },
    {
      "key": "battle.skill.c1001.s3.name",
      "zhCn": "继承者之剑"
    },
    {
      "key": "battle.skill.c1001.s3.description",
      "zhCn": "攻击全体敌人，随后使全体友军防御提升2回合。伤害随施术者最大生命提高。"
    },
    {
      "key": "battle.skill.c1005.s1.name",
      "zhCn": "神圣闪电"
    },
    {
      "key": "battle.skill.c1005.s1.description",
      "zhCn": "攻击两名敌人，随后使自身行动条提高15%。"
    },
    {
      "key": "battle.skill.c1005.s2.name",
      "zhCn": "次元裂隙"
    },
    {
      "key": "battle.skill.c1005.s2.description",
      "zhCn": "攻击全体敌人，对目标有55%概率解除一个增益。自身有攻击提升时，追加一次同技能攻击。"
    },
    {
      "key": "battle.skill.c1005.s3.name",
      "zhCn": "卡尔的炽焰之眼"
    },
    {
      "key": "battle.skill.c1005.s3.description",
      "zhCn": "攻击全体敌人，随后使全体友军攻击提升2回合。魂燃消耗10魂，使本技能赋予的增益延长1回合。"
    },
    {
      "key": "battle.skill.c1062.s1.name",
      "zhCn": "神圣打击"
    },
    {
      "key": "battle.skill.c1062.s1.description",
      "zhCn": "攻击一名敌人，有20%概率使其眩晕1回合。"
    },
    {
      "key": "battle.skill.c1062.s2.name",
      "zhCn": "生命起源"
    },
    {
      "key": "battle.skill.c1062.s2.description",
      "zhCn": "治疗选定友军及生命最低的友军，治疗量随施术者最大生命提高。"
    },
    {
      "key": "battle.skill.c1062.s3.name",
      "zhCn": "女神的指引"
    },
    {
      "key": "battle.skill.c1062.s3.description",
      "zhCn": "治疗全体友军并赋予免疫及屏障2回合。治疗及屏障随施术者最大生命提高。魂燃消耗20魂，使本技能赋予的增益延长2回合。"
    },
