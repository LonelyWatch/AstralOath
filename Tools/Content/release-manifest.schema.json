{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AstralOath content release manifest",
  "type": "object",
  "required": ["version", "protocolVersion", "schemaVersion", "files"],
  "properties": {
    "version": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "protocolVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": { "type": "string", "maxLength": 240, "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}(/[A-Za-z0-9_][A-Za-z0-9_.-]{0,127})*$" },
          "size": { "type": "integer", "minimum": 0, "maximum": 8589934592 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
